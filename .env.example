# PostgreSQL container bootstrap
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_ROOT_USER=postgres_root
POSTGRES_ROOT_PASSWORD=postgres_root_password

# Application database connection target
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkout_system
DB_SCHEMA=app

# Flyway migration authority
DB_MIGRATOR_USER=checkout_migrator
DB_MIGRATOR_PASS=change-me

# Application runtime authority
DB_RUNTIME_USER=checkout_runtime
DB_RUNTIME_PASS=change-me